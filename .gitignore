# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Jupyter Notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
*.env
secrets.toml
# Never commit credentials or API keys
*_credentials.*
*_secret*

# ── Streamlit ─────────────────────────────────────────────────────────────────
# User-specific Streamlit config (credentials stored here after first run)
~/.streamlit/credentials.toml
streamlit_app/.streamlit/credentials.toml

# ── Data files (large / sensitive) ───────────────────────────────────────────
*.csv
*.json
*.parquet
*.db
*.sqlite
*.sqlite3
# Keep requirements and config but not raw data dumps

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── Logs & temp ───────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
pip-log.txt
pip-delete-this-directory.txt

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
